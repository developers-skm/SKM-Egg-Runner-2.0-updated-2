rules_version = '2';

// ──────────────────────────────────────────────────────────────
// SKM EGG RUNNER + PROTEIN TRACKER 2.0 — Firestore Security Rules
// ──────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Core auth helpers ────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // ── Developer role check ─────────────────────────────────
    // Reads the authenticated user's own document and checks role == "developer".
    // This is safe: it only reads the caller's own doc, and only if authenticated.
    function isDeveloper() {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer';
    }

    // ── GAME COLLECTIONS ────────────────────────────────────

    match /users/{uid} {
      // Owner reads their own doc; developers read any user doc for analytics
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.playerName is string
                    && request.resource.data.playerName.size() >= 2
                    && request.resource.data.playerName.size() <= 30;
      // Owner updates own fields (including fcmToken, platform, browser for push);
      // developer may set role field on any user
      allow update: if isOwner(uid)
                    || (isDeveloper() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','updatedAt']));
      allow delete: if false;
    }

    // ── NOTIFICATION COLLECTIONS ─────────────────────────────

    match /notifications/{notifId} {
      // Scoped to the owning user (or a developer). The app's query already
      // filters by userId, so this doesn't change legitimate reads — it
      // closes off a direct collection().get() by any authenticated user
      // that could otherwise enumerate every user's notification content.
      allow read: if isAuth()
                  && (resource.data.userId == request.auth.uid || isDeveloper());

      // Users create their own notifications; developers/broadcasts create any
      allow create: if isAuth()
                    && (request.resource.data.userId == request.auth.uid
                        || isDeveloper()
                        || request.resource.data.targetAll == true);

      // Owner marks as read. Cloud Function (Admin SDK) writes fcmDelivered —
      // Admin SDK bypasses rules entirely so no rule needed for CF updates.
      allow update: if isAuth()
                    && resource.data.userId == request.auth.uid;

      // Owner or developer can delete
      allow delete: if isAuth()
                    && (resource.data.userId == request.auth.uid || isDeveloper());
    }

    // Notification settings per user — owner read/write only
    match /notification_settings/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid) || isDeveloper();
    }

    // Reminder state per user — owner read/write only
    match /reminder_state/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid) || isDeveloper();
    }

    // Broadcast logs — developer-only. The NOTIFY UI (adminBroadcastService.ts)
    // does not currently perform a client-side role check before calling this,
    // so without a rule restricting create, any authenticated user reaching
    // that code path could write fake audit-log entries or read every user's
    // notification broadcast history.
    match /broadcast_logs/{logId} {
      allow read:   if isDeveloper();
      allow create: if isDeveloper();
      allow update: if false;
      allow delete: if isDeveloper();
    }

    match /leaderboard/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.distance >= 0
                    && request.resource.data.playerName is string
                    && request.resource.data.playerName.size() >= 2;
      allow update: if isOwner(uid)
                    && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    match /missions/{uid}/daily/{missionId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && request.resource.data.progress <= resource.data.target
                    && request.resource.data.progress >= 0
                    && (resource.data.claimed == false || request.resource.data.claimed == true);
      allow delete: if false;
    }

    match /achievements/{uid}/list/{achievementId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    && request.resource.data.progress >= 0
                    && (resource.data.claimed == false || request.resource.data.claimed == true);
      allow delete: if false;
    }

    match /settings/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid)
                   && onlyFields(['uid','musicEnabled','sfxEnabled','vibrationEnabled','reminderEnabled','reminderTimes','updatedAt']);
    }

    match /qrCodes/{code} {
      allow read:   if isAuth();
      // Any authenticated user can scan a QR code.
      // Rule: new playCount must be exactly old + 1, must not exceed maxPlays,
      // and other fields (dailyScans, lastScannedAt) may also be written.
      // NOTE: we do NOT use FieldValue.increment() in the scan transaction
      // because Security Rules evaluate request.resource.data which contains
      // the final merged value — plain integer assignment is fully verifiable.
      allow update: if isAuth()
                    && request.resource.data.playCount == resource.data.playCount + 1
                    && request.resource.data.playCount <= resource.data.maxPlays
                    && request.resource.data.active    == resource.data.active
                    && request.resource.data.maxPlays  == resource.data.maxPlays;
      // Developer: full update access (bulk disable / enable / admin ops)
      allow update: if isDeveloper();
      // Protein tracker: atomically mark an egg as globally consumed.
      // Only allowed when proteinConsumed is not already true, and only the
      // three protein fields may change — all game fields remain untouched.
      allow update: if isAuth()
                    && resource.data.get('proteinConsumed', false) == false
                    && request.resource.data.proteinConsumed == true
                    && request.resource.data.proteinConsumedByUID == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['proteinConsumed','proteinConsumedAt','proteinConsumedByUID']);
      // Only developers create QR codes (via QR Management tooling). Previously
      // any authenticated user could create a qrCodes doc, which let a client
      // mint its own unlimited-play/unlimited-protein-claim QR code by writing
      // { active: true, maxPlays: 999999, playCount: 0 } directly.
      allow create: if isDeveloper();
      // Only developers can delete QR codes
      allow delete: if isDeveloper();
    }

    // Protein scan dedup — one doc per user+QR combination.
    // Doc ID is "{uid}_{qrCode}". Any authenticated user can read/create
    // their own dedup records. resource.data is null on missing docs so
    // we cannot check resource.data.userId on read — allow any auth read.
    match /proteinScans/{scanId} {
      allow read:   if isAuth();
      allow create: if isAuth()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.proteinAdded is number
                    && request.resource.data.qrId is string;
      allow update: if false;
      allow delete: if false;
    }

    // Admin operation log — developer read/write/delete only
    match /qrOperationLogs/{logId} {
      allow read:   if isDeveloper();
      allow create: if isDeveloper();
      allow update: if false;
      allow delete: if isDeveloper();
    }

    match /gameConfig/{docId} {
      allow read:  if isAuth();
      // Developer may write config. The previous fallback
      // (`request.auth.uid == 'YOUR_DEVELOPER_UID'`) was an unreplaced
      // placeholder — never matches a real Firebase UID, so it was inert,
      // but removed to avoid a stale bypass clause in production rules.
      allow write: if isDeveloper();
    }

    // QR Management Settings (game link mapping, etc.) — developer only
    match /skm_config/{docId} {
      allow read:  if isDeveloper();
      allow write: if isDeveloper();
    }

    // Game missions (subcollection used by game engine)
    match /game_missions/{uid}/{document=**} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow write:  if isOwner(uid);
    }

    // Game stats bridge — Egg Runner run summaries, read by the Protein
    // Tracker/Rewards Club (see services/game/gameStatsService.ts) and used
    // there to gate Stage-2 reward unlocks (rewardCouponService.redeemReward).
    // Unlike other collections, this was previously `allow write: if isOwner(uid)`
    // with NO field validation — a client could set highestStage directly to
    // 'STAGE2' without ever playing a run. highestStage must now be one of the
    // real enum values and can only advance (never regress) relative to the
    // existing document, mirroring the client-side ratchet in gameStatsService.ts
    // so the ratchet is actually enforced, not just advisory.
    function gameStageRank(stage) {
      return stage == 'EGG'    ? 0
           : stage == 'CHICK'  ? 1
           : stage == 'ADULT'  ? 2
           : stage == 'STAGE2' ? 3
           : -1;
    }
    match /users/{uid}/gameStats/{docId} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid)
                    && gameStageRank(request.resource.data.highestStage) >= 0;
      allow update: if isOwner(uid)
                    && gameStageRank(request.resource.data.highestStage) >= 0
                    && gameStageRank(request.resource.data.highestStage) >= gameStageRank(resource.data.get('highestStage', 'EGG'));
    }

    // ── PROTEIN TRACKER COLLECTIONS ─────────────────────────

    match /protein_logs/{uid}/entries/{entryId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.protein is number
                    && request.resource.data.protein >= 0;
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /daily_stats/{uid}/days/{dateKey} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /tracker_achievements/{uid}/list/{achievementId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /tracker_challenges/{uid}/list/{challengeId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /userSummary/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid);
    }

    match /tracker_settings/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid);
    }

    match /tracker_rewards/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid);
    }

    match /tracker_leaderboard/{uid} {
      allow read:   if isAuth();
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── RETENTION COLLECTIONS ─────────────────────────────────

    match /login_streaks/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid);
    }
    match /login_streaks/{uid}/claims/{claimId} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if false;
      allow delete: if false;
    }

    match /daily_missions/{uid}/days/{missionId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /weekly_missions/{uid}/weeks/{missionId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /streak_shields/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid);
    }

    match /game_rewards/{uid}/unlocked/{rewardId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── EGG STREAK HISTORY ────────────────────────────────────
    match /streakHistory/{uid}/days/{dateKey} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── MILESTONE REWARDS (claimed sticker list) ──────────────
    match /milestone_rewards/{uid} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // ── SMART HEALTH PROFILE (BMI + personalized protein goal) ──
    match /health_profiles/{uid} {
      allow read:  if isOwner(uid) || isDeveloper();
      allow write: if isOwner(uid);
    }

    // ── SKM REWARDS CLUB (loyalty points, membership, coupons) ──
    // The client SDK writes this doc directly (rewardWalletService.ts —
    // addPointsInTransaction/spendPointsInTransaction, used by processEggScan
    // and redeemReward), so a full lock-to-developer would break the app.
    // Instead we bound what a write may do: lifetimePoints and totalRedeemed
    // are monotonically non-decreasing (they represent all-time totals and
    // must never be reset downward by a client), and currentPoints can never
    // go negative. This blocks the exploit of a client directly setDoc-ing an
    // arbitrary currentPoints/membership value, while still allowing the
    // legitimate earn/spend paths (which only ever increment or decrement by
    // a bounded amount) to succeed.
    //
    // create allows a brand-new wallet's very first write to already contain
    // a genuine first scan's points (processEggScan folds wallet creation and
    // the first point-earn into one transaction — there is no longer a
    // separate zeroed bootstrap write before the real mutation), capped at
    // MAX_SINGLE_SCAN_POINTS so a client can't mint an arbitrary starting
    // balance. totalRedeemed must still be 0 on create — nothing can be
    // redeemed before a wallet exists.
    match /rewardWallet/{uid} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid)
                    && request.resource.data.currentPoints  >= 0
                    && request.resource.data.currentPoints  <= 3000
                    && request.resource.data.lifetimePoints == request.resource.data.currentPoints
                    && request.resource.data.totalRedeemed  == 0;
      allow update: if isOwner(uid)
                    && request.resource.data.currentPoints  >= 0
                    && request.resource.data.lifetimePoints >= resource.data.lifetimePoints
                    && request.resource.data.totalRedeemed  >= resource.data.totalRedeemed;
      allow delete: if false;
    }

    match /rewardTransactions/{uid}/entries/{entryId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid) && request.resource.data.userId == uid;
      allow update: if false; // immutable ledger
      allow delete: if false;
    }

    // Coupon status only ever moves one-way: available -> used, or
    // available -> expired (see rewardCouponService.ts markCouponUsed /
    // getUserCoupons). Previously any owner update was allowed, which let a
    // client flip a used/expired coupon back to "available" and reuse it.
    match /rewardCoupons/{uid}/redemptions/{couponId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid) && request.resource.data.userId == uid;
      allow update: if isOwner(uid)
                    && resource.data.status == 'available'
                    && (request.resource.data.status == 'used' || request.resource.data.status == 'expired')
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt']);
      allow delete: if false;
    }

    // Admin-managed reward catalog — any authenticated user reads, only developers write.
    match /rewardCatalog/{itemId} {
      allow read:  if isAuth();
      allow write: if isDeveloper();
    }

    // Admin-managed promotional events (Double Points Day, Weekend Bonus, etc.)
    // any authenticated user reads, only developers write.
    match /promoEvents/{eventId} {
      allow read:  if isAuth();
      allow write: if isDeveloper();
    }

    // Admin-managed seasonal reward campaigns — any authenticated user reads,
    // only developers write. Client also creates the autoRestart clone doc
    // (rewardCampaignService.cloneCampaignForward), so any authenticated user
    // may create — never update/delete an existing campaign definition.
    match /rewardCampaigns/{campaignId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isDeveloper();
      allow delete: if isDeveloper();
    }

    // Per-user archived campaign progress, written once by the owner when
    // their active campaign expires (rewardCampaignService.archiveCampaignForUser).
    match /campaignHistory/{uid}/periods/{campaignId} {
      allow read:   if isOwner(uid) || isDeveloper();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid); // merge:true — allows re-archiving without duplicating logic
      allow delete: if false;
    }

  }
}
